<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Airlift.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes><ColorPaletteResources x:Key="Dark" Accent="#D7F59A"/><!-- initial only; Theme.Apply publishes SystemAccentColor* --></FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Airlift.Window}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.TextBright}"/>
      <Setter Property="FontFamily" Value="avares://Airlift/Assets/Fonts#DM Sans"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="13,8"/>
      <Setter Property="MinHeight" Value="34"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Airlift.Raised}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.TextButton}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Airlift.LineButton}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Airlift.ButtonHover}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.LineButtonHover}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.TextBright}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.Pressed}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Accent}"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Airlift.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.AccentOn}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.AccentHover}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.AccentOn}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.AccentHover}"/></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.AccentPressed}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.AccentOn}"/></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="13,0"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Subtle}"/></Style>
    <Style Selector="Button.nav.active"><Setter Property="Background" Value="{DynamicResource Airlift.Active}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Accent}"/></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.Hover}"/></Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.ActiveHover}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Accent}"/></Style>
    <Style Selector="Button.link, Button.identity"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <!-- App identity stays transparent in every pointer state; keyboard focus retains its outline. -->
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.identity:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.identity:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Accent}"/>
    </Style>
    <Style Selector="Button.identity:pressed"><Setter Property="RenderTransform" Value="none"/></Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource Airlift.Accent}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.chip"><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,7"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Subtle}"/></Style>
    <Style Selector="Button.chip.active"><Setter Property="Background" Value="{DynamicResource Airlift.Active}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Accent}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="{DynamicResource Airlift.DangerSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.DangerLine}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.DangerText}"/></Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.DangerHoverSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.DangerHoverLine}"/><Setter Property="Foreground" Value="{DynamicResource Airlift.DangerHoverText}"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    <!-- Keep a dark glyph against the pale accent in checked, hovered and pressed states. -->
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph, CheckBox:indeterminate /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource Airlift.AccentOn}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource Airlift.Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.Accent}"/>
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Path#CheckGlyph, CheckBox:checked:pressed /template/ Path#CheckGlyph, CheckBox:indeterminate:pointerover /template/ Path#CheckGlyph, CheckBox:indeterminate:pressed /template/ Path#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource Airlift.AccentOn}"/></Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle, CheckBox:indeterminate:pointerover /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource Airlift.AccentHover}"/></Style>
    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle, CheckBox:indeterminate:pressed /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource Airlift.AccentPressed}"/></Style>
    <Style Selector="CheckBox:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
    <!-- Airlift draws its own window frame: caption glyphs inherit the button Foreground. -->
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Faint}"/>
    </Style>
    <Style Selector="Button.chrome:pointerover"><Setter Property="Foreground" Value="{DynamicResource Airlift.TextBright}"/></Style>
    <Style Selector="Button.chrome:pressed"><Setter Property="Foreground" Value="{DynamicResource Airlift.TextBright}"/></Style>
    <Style Selector="Button.chrome.close:pointerover, Button.chrome.close:pressed"><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.ChromeHover}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.chrome:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.ChromePressed}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.CloseHover}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.chrome.close:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.ClosePressed}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.clear">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Foreground" Value="{DynamicResource Airlift.Faint}"/>
    </Style>
    <Style Selector="Button.clear:pointerover"><Setter Property="Foreground" Value="{DynamicResource Airlift.TextBright}"/></Style>
    <Style Selector="Button.clear:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.ClearHover}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.clear:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.ClearPressed}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.version">
      <Setter Property="Background" Value="{DynamicResource Airlift.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.Line}"/><Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="11,10"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.version:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.CardHover}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.LineStrong}"/></Style>
    <Style Selector="Button.version:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Airlift.Pressed}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.LineStrong}"/></Style>
    <Style Selector="Border.app-card"><Setter Property="BorderBrush" Value="{DynamicResource Airlift.Line}"/></Style>
    <Style Selector="Border.app-card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Airlift.LineStrong}"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="Background" Value="{DynamicResource Airlift.Field}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.Line}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,9"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{DynamicResource Airlift.Field}"/><Setter Property="BorderBrush" Value="{DynamicResource Airlift.Line}"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Airlift.Accent}"/><Setter Property="Background" Value="{DynamicResource Airlift.Line}"/><Setter Property="Height" Value="4"/><Setter Property="CornerRadius" Value="2"/></Style>
    <Style Selector="ScrollBar"><Setter Property="Width" Value="8"/></Style>
  </Application.Styles>
</Application>
